{
	"name": "pishock-discord-activity",
	"compatibility_date": "2024-01-15",
	
	// COMPLETELY disable ALL Cloudflare analytics and optimization features
	"analytics_engine_datasets": [],
	"send_metrics": false,
	
	// Static assets configuration
	"assets": {
		"directory": "./dist"
	},
	
	// Main worker script (compiled from Pages Functions) - only for API routes
	"main": "./dist/_worker.js",
	
	// KV namespace bindings
	"kv_namespaces": [
		{
			"binding": "PISHOCK_KV",
			"id": "7378d506c9114ab284f40ff07ed2a44c",
			"preview_id": "f6f7930286dc4624b80efaec808dd6ae"
		}
	],

  
	// Logging configuration (equivalent to [observability.logs] enabled = true in wrangler.toml)
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	
	// Runtime environment variables (for worker functions only)
	// Build-time variables (VITE_*) must be set via wrangler deploy --var or locally
	"vars": {
		"CF_PAGES": "1",
		"CF_ANALYTICS_DISABLED": "true",
		"CF_WEB_ANALYTICS_DISABLED": "true",
		"CF_BROWSER_INSIGHTS_DISABLED": "true",
		// Note: VITE_DISCORD_CLIENT_ID is a BUILD-TIME variable
		// It must be set during npm run build, not here
		"BUILD_INFO": "Set DISCORD_CLIENT_ID before build"
	}
}