{
  "name": "pishock-discord-activity",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm install && vite build && npx wrangler pages functions build --outdir=./dist/_worker.js/ --bindings='{\"kv_namespaces\":[{\"binding\":\"PISHOCK_KV\"}]}' && node scripts/post-build.js",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "preview": "vite preview",
    "workers:dev": "npx wrangler dev --local",
    "workers:deploy": "npx wrangler deploy",
    "deploy": "npm install && npm run build && npm run workers:deploy",
    "deploy:with-env": "npm install && DISCORD_CLIENT_ID=${DISCORD_CLIENT_ID} npm run build && npm run workers:deploy",
    "deploy:auto": "node scripts/deploy-workers.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^1.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "wrangler": "^4.0.0"
  }
}