{
  "name": "pishock-discord-activity",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev -w web\" \"npm run dev -w server\"",
    "build": "npm run build -w web && npm run build -w server",
    "typecheck": "npm run build -w server && npm run typecheck -w web",
    "start": "npm run start -w server",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^6.8.2"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2"
  }
}
