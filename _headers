# NUCLEAR OPTION: Block ALL Cloudflare script injection
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  # Disable EVERY Cloudflare feature that could inject scripts
  CF-Analytics: off
  CF-Web-Analytics: off
  CF-Browser-Insights: off
  CF-Ray: off
  CF-Cache-Status: BYPASS
  CF-Polish: off
  CF-Mirage: off
  CF-Rocket-Loader: off
  CF-Auto-Minify: off
  CF-ScrapeShield: off
  CF-APO-Bypass: 1
  CF-Speed-Brain: off
  CF-Apps: off
  CF-Cron-Trigger: off
  CF-Early-Hints: off
  CF-Bot-Management: off
  CF-Zone-Id: bypass
  CF-Worker: bypass
  # ULTRA-STRICT CSP - ONLY application scripts allowed
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' blob:; script-src-elem 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.discordapp.com; connect-src 'self' https://discord.com https://api.pishock.com; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; block-all-mixed-content

# API routes CORS headers
/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With
  Access-Control-Max-Age: 86400

# Version endpoint - never cache
/api/version
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# User-specific PiShock endpoints - never cache at edge
/api/users/*/pishock-status
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Vary: Authorization

/api/users/*/pishock-settings
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Vary: Authorization

/api/users/*/pishock-test
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Vary: Authorization

/api/users/*/pishock-execute
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Vary: Authorization

# Discord member data - medium cache
/api/discord/guilds/*/members/*
  Cache-Control: public, max-age=300, stale-while-revalidate=60
  Vary: Authorization

# Activity log - short cache for real-time feel
/api/activity-log
  Cache-Control: public, max-age=30, stale-while-revalidate=15
  Vary: Authorization

# Static assets caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Main app files
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# HTML files - ultra-strict CSP and no cache
/*.html
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' blob:; script-src-elem 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.discordapp.com; connect-src 'self' https://discord.com https://api.pishock.com; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; block-all-mixed-content