# Global headers for all routes - DISABLE ALL CLOUDFLARE FEATURES
/*
  X-Frame-Options: ALLOWALL
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  # Completely disable Cloudflare features that inject scripts
  CF-Cache-Status: BYPASS
  CF-Analytics: off
  CF-Web-Analytics: off
  CF-Browser-Insights: off
  CF-APO-Bypass: 1
  CF-Ray: off
  # Prevent automatic optimizations that might inject scripts
  CF-Polish: off
  CF-Mirage: off
  CF-Rocket-Loader: off

# API routes CORS headers
/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-Requested-With
  Access-Control-Max-Age: 86400

# Version endpoint - never cache
/api/version
  Cache-Control: no-cache, no-store, must-revalidate, max-age=0
  Pragma: no-cache
  Expires: 0

# Static assets caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Main app files
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# HTML files - strict CSP and no cache
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.discordapp.com; connect-src 'self' https://discord.com https://do.pishock.com https://auth.pishock.com https://ps.pishock.com; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'