# Database — use localhost when running `docker compose up -d postgres` on the same machine
# (postgres service publishes 5432:5432). Inside the app container use host `postgres` instead.
DATABASE_URL=postgresql://pishock:pishock@localhost:5432/pishock

# 32-byte hex key for AES-256-GCM credential encryption (generate: openssl rand -hex 32)
ENCRYPTION_KEY=

# Discord OAuth / Activity
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
VITE_DISCORD_CLIENT_ID=
VITE_OWNER_ADMIN_USER_IDS=

# Comma-separated Discord user IDs allowed to call admin APIs
OWNER_ADMIN_USER_IDS=

NODE_ENV=development
PORT=3000
API_PORT=3001
