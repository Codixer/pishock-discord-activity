# Discord Application Configuration (Required for build)
VITE_DISCORD_CLIENT_ID=your_discord_client_id_here

# For Cloudflare Workers deployment, you can also set these as environment variables:
# export DISCORD_CLIENT_ID="your_discord_client_id_here"
# Then use: npm run deploy:with-env

# Worker Runtime Variables (set these in Cloudflare Workers Dashboard → Settings → Variables)
# DISCORD_CLIENT_SECRET=your_discord_client_secret
# DISCORD_BOT_TOKEN=your_discord_bot_token
# PISHOCK_RELAY_API_KEY=relay_account_api_key
# PISHOCK_RELAY_USERNAME=relay_account_username
# Note: Relay accounts use account-only access, no sharecode needed

# ⚠️  SECURITY WARNING ⚠️ 
# NEVER use VITE_ prefix for sensitive data like API keys!
# VITE_ variables are bundled into the frontend and visible in browser
# 
# ✅ Safe for frontend: VITE_DISCORD_CLIENT_ID (public client ID)
# ❌ NEVER for frontend: VITE_PISHOCK_API_KEY (sensitive API key)
# 
# PiShock API keys should ONLY be set in:
# 1. Cloudflare Workers Dashboard → Settings → Variables (for runtime)
# 2. User configuration in the app UI (stored encrypted in KV)