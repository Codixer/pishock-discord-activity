# Discord Application Configuration
VITE_DISCORD_CLIENT_ID=your_discord_client_id_here

# PiShock API Configuration (Optional - can be configured in-app)
VITE_PISHOCK_API_KEY=your_pishock_api_key
VITE_PISHOCK_USERNAME=your_pishock_username

# Cloudflare Pages Environment Variables (set in dashboard)
# DISCORD_CLIENT_SECRET=your_discord_client_secret
# PISHOCK_API_URL=https://do.pishock.com/api/apioperate

# Relay Account Configuration (Optional - for users without PiShock accounts)
# PISHOCK_RELAY_API_KEY=relay_account_api_key
# PISHOCK_RELAY_USERNAME=relay_account_username
# PISHOCK_RELAY_SHARECODE=relay_account_sharecode