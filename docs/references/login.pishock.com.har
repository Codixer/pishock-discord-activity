            "mimeType": "text/css",
            "text": "/* _content/UILibrary/Components/Checkbox.razor.rz.scp.css */\n/* Custom Checkbox Component Styles */\n\n.custom-checkbox[b-8djh93z7xd] {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.5rem;\n    cursor: pointer;\n    user-select: none;\n}\n\n.custom-checkbox.disabled[b-8djh93z7xd] {\n    opacity: 0.5;\n    cursor: not-allowed;\n    pointer-events: none;\n}\n\n.checkbox-box[b-8djh93z7xd] {\n    width: 24px;\n    height: 24px;\n    border: 2px solid var(--border-color, rgba(125, 211, 247, 0.5));\n    border-radius: 4px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background-color: transparent;\n    transition: all 0.15s ease;\n    color: var(--primary-color, #7DD3F7);\n    font-size: 18px;\n}\n\n.checkbox-box:hover[b-8djh93z7xd] {\n    border-color: var(--primary-color, #7DD3F7);\n}\n\n.checkbox-box.checked[b-8djh93z7xd] {\n    border-color: var(--primary-color, #7DD3F7);\n    background-color: rgba(125, 211, 247, 0.1);\n}\n\n.checkbox-box.checked[b-8djh93z7xd]  .icon {\n    color: var(--primary-color, #7DD3F7);\n}\n\n.checkbox-label[b-8djh93z7xd] {\n    color: var(--text-primary, #fff);\n    font-size: 0.875rem;\n}\n/* _content/UILibrary/Components/Navigation/NavBar.razor.rz.scp.css */\nnav[b-3q9bk7ximd]\n{\n    position:relative;\n    padding:20px;\n    background-color: #1e1e1e;\n    z-index:10;\n}\n\n.nav-inner[b-3q9bk7ximd]\n{\n    display: flex;\n    flex-direction: column;\n    width: 80%;\n    gap: 12px;\n}\n\n.nav-top-row[b-3q9bk7ximd]\n{\n    display: flex;\n    align-items: center;\n    gap: 2rem;\n}\n\n.nav-links[b-3q9bk7ximd]\n{\n    flex: 1 1 auto;\n    gap: 2rem;\n}\n\n.nav-actions[b-3q9bk7ximd]\n{\n    flex: 0 0 auto;\n    gap: 1rem;\n}\n\n.nav-hamburger[b-3q9bk7ximd]\n{\n    margin-left: auto;\n    padding: 8px 12px;\n}\n\n.nav-mobile[b-3q9bk7ximd]\n{\n    position: relative;\n    z-index: 11;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    padding-top: 12px;\n    border-top: 1px solid rgba(255, 255, 255, 0.12);\n}\n\n.nav-mobile-links[b-3q9bk7ximd],\n.nav-mobile-actions[b-3q9bk7ximd]\n{\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n}\n\nbutton[b-3q9bk7ximd]\n{\n    padding: 8px 15px 8px 15px;\n    border-radius:30px;\n    border:3px solid #89d3f4;\n    font-size:18px;\n    font-weight:bold;\n    font-size: 12px;\n    font-weight: 700;\n    color:#000;\n    border:3px solid #89d3f4;\n    background-color:#89d3f4;\n    text-transform: uppercase;\n}\n\nbutton.hollow[b-3q9bk7ximd]\n{\n    color:#7bccee;\n    background-color:#1e1e1e;\n}\n\n\n[b-3q9bk7ximd] button svg\n{\n    margin-right: 5px;\n    height: 30px;\n    width: 40px;\n}\n\n[b-3q9bk7ximd] .nav-hamburger svg\n{\n    margin-right: 0;\n    height: 22px;\n    width: 22px;\n}\n\n[b-3q9bk7ximd] .link\n{\n    font-size: 18px;\n}\ndiv.overlay[b-3q9bk7ximd]\n{\n    position:fixed;\n    background-color:transparent;\n    inset: 0;\n    z-index:5;\n    pointer-events: auto;\n}\n\n@media (max-width: 1399.98px)\n{\n    nav[b-3q9bk7ximd]\n    {\n        padding: 12px;\n    }\n\n    .nav-inner[b-3q9bk7ximd]\n    {\n        width: 100%;\n    }\n\n    .nav-top-row[b-3q9bk7ximd]\n    {\n        gap: 12px;\n    }\n\n    .nav-hamburger[b-3q9bk7ximd]\n    {\n        display: flex !important;\n    }\n\n    .nav-links[b-3q9bk7ximd],\n    .nav-actions[b-3q9bk7ximd]\n    {\n        display: none !important;\n    }\n\n    [b-3q9bk7ximd] .link\n    {\n        font-size: 16px;\n    }\n\n    button[b-3q9bk7ximd]\n    {\n        font-size: 12px;\n        padding: 8px 12px;\n    }\n\n    [b-3q9bk7ximd] button svg\n    {\n        height: 20px;\n        width: 24px;\n    }\n}\n/* _content/UILibrary/Components/Navigation/NavLi.razor.rz.scp.css */\nli[b-k85t8qjcw8]  svg\n{\n    width:20px;\n}\n\nli[b-k85t8qjcw8]\n{\n    padding: 10px 10px 10px 20px;\n    border-top:1px solid #000;\n    width:100%;\n    font-size:18px;\n    cursor: pointer;\n}\n/* _content/UILibrary/Components/Navigation/NavUserBar.razor.rz.scp.css */\ndiv div#profile[b-0kobhonxeh]  svg.iconify\n{\n    display: inline-flex;\n    font-size:40px;\n    justify-content:flex-end;\n}\n\ndiv div#profile img[b-0kobhonxeh]\n{\n    width:52px;\n    height:52px;\n    margin-right:10px;\n}\n\ndiv div#profile[b-0kobhonxeh]\n{\n    min-width:300px;\n    cursor:pointer;\n    font-size:18px;\n}\n\ndiv div#profile span[b-0kobhonxeh]\n{\n    display:inline-block;\n    width:300px;\n    overflow:hidden;\n    text-overflow:ellipsis;\n}\n\ndiv div#profile[b-0kobhonxeh]  svg\n{\n    width: 40px;\n}\n\ndiv div#submenu[b-0kobhonxeh]\n{\n    position: absolute;\n    background-color: #1e1e1e;\n    width: 350px;\n    top: 92px;\n    z-index: 12;\n    margin-left: 6px;\n}\n\ndiv div#submenu ul[b-0kobhonxeh]\n{\n    text-decoration: none;\n    list-style-type: none;\n    padding-left:0px;\n}\n\ndiv div#submenu ul li[b-0kobhonxeh]\n{\n    padding: 10px 10px 10px 20px;\n    border-top:1px solid #000;\n    width:100%;\n    font-size:18px;\n}\n\ndiv div#submenu ul li button[b-0kobhonxeh]\n{\n    background-color:#f77d7d;\n    width:100%;\n    text-align:center;\n    color:#000;\n    border-radius:30px;\n    text-transform: uppercase;\n    font-weight:700;\n}\n/* _content/UILibrary/Components/Navigation/PiShockLogo.razor.rz.scp.css */\nimg[b-r3e1ne8pc4]\n{\n    height: 40px;\n}\n/* _content/UILibrary/Components/RangeSlider.razor.rz.scp.css */\n/* Range Slider Component Styles */\n\n.range-slider-container[b-j79rgfrlxk] {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n/* Vertical orientation (default) */\n.range-slider-container.vertical[b-j79rgfrlxk] {\n    height: 100%;\n    min-height: 180px;\n    width: 10px;\n}\n\n/* Horizontal orientation */\n.range-slider-container.horizontal[b-j79rgfrlxk] {\n    width: 180px;\n    height: 10px;\n}\n\n/* Track background */\n.range-slider-track[b-j79rgfrlxk] {\n    position: absolute;\n    background: var(--surface-color, #2a2a2a);\n    border-radius: 5px;\n    border: 1px solid var(--border-color, rgba(125, 211, 247, 0.3));\n}\n\n.range-slider-container.vertical .range-slider-track[b-j79rgfrlxk] {\n    width: 100%;\n    height: 100%;\n}\n\n.range-slider-container.horizontal .range-slider-track[b-j79rgfrlxk] {\n    width: 100%;\n    height: 100%;\n}\n\n/* Highlighted range between min and max */\n.range-slider-highlight[b-j79rgfrlxk] {\n    position: absolute;\n    background: var(--primary-color, #7DD3F7);\n    border-radius: 5px;\n    pointer-events: none;\n}\n\n.range-slider-container.vertical .range-slider-highlight[b-j79rgfrlxk] {\n    width: 100%;\n    left: 0;\n}\n\n.range-slider-container.horizontal .range-slider-highlight[b-j79rgfrlxk] {\n    height: 100%;\n    top: 0;\n}\n\n/* Range inputs - overlay both on same track */\n.range-slider-input[b-j79rgfrlxk] {\n    position: absolute;\n    background: transparent;\n    pointer-events: none;\n    -webkit-appearance: none;\n    appearance: none;\n    margin: 0;\n    padding: 0;\n}\n\n.range-slider-container.vertical .range-slider-input[b-j79rgfrlxk] {\n    writing-mode: vertical-lr;\n    direction: rtl;\n    height: 100%;\n    width: 20px;\n}\n\n.range-slider-container.horizontal .range-slider-input[b-j79rgfrlxk] {\n    width: 100%;\n    height: 20px;\n}\n\n/* Webkit (Chrome, Safari, Edge) thumb styles */\n.range-slider-input[b-j79rgfrlxk]::-webkit-slider-thumb {\n    pointer-events: auto;\n    -webkit-appearance: none;\n    appearance: none;\n    width: 16px;\n    height: 16px;\n    border-radius: 50%;\n    background: var(--primary-color, #7DD3F7);\n    cursor: pointer;\n    border: 2px solid var(--surface-dark, #131312);\n    box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);\n    transition: transform 0.1s ease;\n}\n\n.range-slider-input[b-j79rgfrlxk]::-webkit-slider-thumb:hover {\n    transform: scale(1.1);\n}\n\n.range-slider-input[b-j79rgfrlxk]::-webkit-slider-thumb:active {\n    transform: scale(1.15);\n}\n\n/* Firefox thumb styles */\n.range-slider-input[b-j79rgfrlxk]::-moz-range-thumb {\n    pointer-events: auto;\n    width: 16px;\n    height: 16px;\n    border-radius: 50%;\n    background: var(--primary-color, #7DD3F7);\n    cursor: pointer;\n    border: 2px solid var(--surface-dark, #131312);\n    box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);\n    transition: transform 0.1s ease;\n}\n\n.range-slider-input[b-j79rgfrlxk]::-moz-range-thumb:hover {\n    transform: scale(1.1);\n}\n\n.range-slider-input[b-j79rgfrlxk]::-moz-range-thumb:active {\n    transform: scale(1.15);\n}\n\n/* Hide default track styling */\n.range-slider-input[b-j79rgfrlxk]::-webkit-slider-runnable-track {\n    background: transparent;\n    border: none;\n}\n\n.range-slider-input[b-j79rgfrlxk]::-moz-range-track {\n    background: transparent;\n    border: none;\n}\n\n/* Disabled state */\n.range-slider-input:disabled[b-j79rgfrlxk]::-webkit-slider-thumb {\n    background: var(--disabled-color, #555);\n    cursor: not-allowed;\n}\n\n.range-slider-input:disabled[b-j79rgfrlxk]::-moz-range-thumb {\n    background: var(--disabled-color, #555);\n    cursor: not-allowed;\n}\n\n.range-slider-container:has(.range-slider-input:disabled) .range-slider-highlight[b-j79rgfrlxk] {\n    background: var(--disabled-color, #555);\n}\n/* _content/UILibrary/Components/ShockerControl.razor.rz.scp.css */\n/* ShockerControl Component Styles */\n\n.shocker-control[b-jsbfepy0po] {\n    display: flex;\n    flex-direction: column;\n    margin: 0.5rem;\n    transform-origin: top center;\n}\n\n.shocker-card[b-jsbfepy0po] {\n    background-color: var(--surface-color, #1E1F1F);\n    border-radius: 8px;\n    border: 1px solid var(--border-color, rgba(125, 211, 247, 0.3));\n    overflow: hidden;\n}\n\n.card-bordered[b-jsbfepy0po] {\n    border: 1px solid var(--border-color, rgba(125, 211, 247, 0.3));\n}\n\n.header-content[b-jsbfepy0po] {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-top: 10px