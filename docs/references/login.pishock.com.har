          "content": {
            "size": 706,
            "mimeType": "application/javascript",
            "text": "// Safari-compatible localStorage functions with error handling\r\nexport function readLS(key) \r\n{\r\n    try {\r\n        return localStorage.getItem(key);\r\n    } catch (e) {\r\n        console.error(`LocalStorage read error for key '${key}' (Safari private mode?):`, e);\r\n        return null;\r\n    }\r\n}\r\n\r\nexport function writeLS(key, value)\r\n{\r\n    try {\r\n        localStorage.setItem(key, value);\r\n    } catch (e) {\r\n        console.error(`LocalStorage write error for key '${key}' (Safari private mode?):`, e);\r\n    }\r\n}\r\n\r\nexport function removeLS(key)\r\n{\r\n    try {\r\n        localStorage.removeItem(key);\r\n    } catch (e) {\r\n        console.error(`LocalStorage remove error for key '${key}':`, e);\r\n    }\r\n}"
          },
